rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verbali index: shared read/write summary (no photos/signatures — those never leave the
    // device that created the verbale). Open access, no login: users include external companies.
    match /verbali/{verbaleId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasAll(['numero','anno','cantiereId','data'])
        && request.resource.data.size() < 20;
    }
    // Maintenance-mode flag, synced across every device using the published app link.
    match /config/maintenance {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['attiva']);
    }
    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
